{
  "name": "HOLU - Cobro y alta de cuentas (MercadoPago)",
  "nodes": [
    {
      "id": "s1",
      "name": "Webhook - Subscription Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "subscription-start",
      "parameters": {
        "httpMethod": "POST",
        "path": "subscription-start",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "s2",
      "name": "Prepare Signup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// ── Validate & Prepare ───────────────────────────────────────\nconst b = $input.first().json.body ?? $input.first().json;\n\nfor (const f of ['restaurant_name', 'owner_name', 'owner_email']) {\n  if (!b[f] || String(b[f]).trim() === '') throw new Error(`Missing required field: ${f}`);\n}\nif (!/^[^@]+@[^@]+\\.[^@]+$/.test(b.owner_email)) throw new Error('Invalid email address');\n\n// The price is decided here, never by the browser.\nconst PLANS = { basico: 29990, pro: 49990, ia: 79990 };\nconst plan   = PLANS[b.plan] ? b.plan : 'pro';\nconst amount = PLANS[plan];\n\nconst slug = String(b.restaurant_name)\n  .toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40);\nconst signupId = `${slug}-${Math.random().toString(36).slice(2, 6)}`;\n\nreturn [{ json: {\n  signup_id:       signupId,\n  restaurant_name: String(b.restaurant_name).trim(),\n  owner_name:      String(b.owner_name).trim(),\n  owner_email:     String(b.owner_email).trim().toLowerCase(),\n  phone:           b.phone ? String(b.phone).trim() : null,\n  plan, amount,\n  back_url: b.back_url || 'https://holu.pro/?pago=listo',\n}}];"
      }
    },
    {
      "id": "s3",
      "name": "Save Signup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://nlwrkumlrudfgsdnhfhw.supabase.co/rest/v1/signups",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"id\":              \"{{ $json.signup_id }}\",\n  \"restaurant_name\": \"{{ $json.restaurant_name }}\",\n  \"owner_name\":      \"{{ $json.owner_name }}\",\n  \"owner_email\":     \"{{ $json.owner_email }}\",\n  \"phone\":           {{ $json.phone ? '\"' + $json.phone + '\"' : 'null' }},\n  \"plan\":            \"{{ $json.plan }}\",\n  \"amount\":          {{ $json.amount }},\n  \"status\":          \"pending\"\n}",
        "options": {}
      }
    },
    {
      "id": "s4",
      "name": "MP Create Preapproval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.mercadopago.com/preapproval",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"reason\": \"HOLU - Plan {{ $('Prepare Signup').item.json.plan }}\",\n  \"external_reference\": \"{{ $('Prepare Signup').item.json.signup_id }}\",\n  \"payer_email\": \"{{ $('Prepare Signup').item.json.owner_email }}\",\n  \"back_url\": \"{{ $('Prepare Signup').item.json.back_url }}\",\n  \"status\": \"pending\",\n  \"auto_recurring\": {\n    \"frequency\": 1,\n    \"frequency_type\": \"months\",\n    \"transaction_amount\": {{ $('Prepare Signup').item.json.amount }},\n    \"currency_id\": \"CLP\"\n  }\n}",
        "options": {}
      }
    },
    {
      "id": "s5",
      "name": "Link Preapproval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://nlwrkumlrudfgsdnhfhw.supabase.co/rest/v1/signups?id=eq.{{ $('Prepare Signup').item.json.signup_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"mp_preapproval_id\": \"{{ $json.id }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "s6",
      "name": "Respond Checkout Link",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, init_point: $('MP Create Preapproval').item.json.init_point }) }}"
      }
    },
    {
      "id": "m1",
      "name": "Webhook - MP Notification",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        380
      ],
      "webhookId": "mp-webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "mp-webhook",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "m2",
      "name": "Read Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        380
      ],
      "parameters": {
        "jsCode": "// MercadoPago posts { type, action, data: { id } }, sometimes as query params.\n// Only subscription topics carry a preapproval id; anything else is answered\n// 200 and ignored so MercadoPago stops retrying it.\nconst j = $input.first().json;\nconst b = j.body ?? j;\nconst q = j.query ?? {};\nconst type = b.type || b.topic || q.type || q.topic || '';\nconst id   = (b.data && b.data.id) || b.id || q['data.id'] || q.id || null;\nconst isSub = ['subscription_preapproval','preapproval','subscription_authorized_payment'].includes(type);\nreturn [{ json: { handled: Boolean(isSub && id), preapproval_id: id } }];"
      }
    },
    {
      "id": "m3",
      "name": "Is Subscription Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        380
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.handled }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "m4",
      "name": "MP Get Preapproval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        280
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.mercadopago.com/preapproval/{{ $json.preapproval_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "m5",
      "name": "Claim Signup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "https://nlwrkumlrudfgsdnhfhw.supabase.co/rest/v1/rpc/claim_signup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_preapproval_id\": \"{{ $('MP Get Preapproval').item.json.id }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "m6",
      "name": "Decide Provisioning",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        280
      ],
      "parameters": {
        "jsCode": "// claim_signup() hands the work over exactly once, so a retried notification\n// arrives here with already_done = true and provisions nothing.\nconst mp     = $('MP Get Preapproval').first().json;\nconst rows   = $input.first().json;\nconst signup = Array.isArray(rows) ? rows[0] : rows;\n\nconst authorized = mp.status === 'authorized';\nconst provision  = Boolean(authorized && signup && signup.already_done === false);\n\n// Never reaches the browser: it is emailed to the owner by restaurant-onboard.\nconst chars = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789';\nlet password = '';\nfor (let i = 0; i < 12; i++) password += chars[Math.floor(Math.random() * chars.length)];\n\nreturn [{ json: {\n  provision,\n  preapproval_id: mp.id,\n  mp_status: mp.status,\n  next_payment_date: mp.next_payment_date || null,\n  signup_id:  signup ? signup.id : null,\n  restaurant_name: signup ? signup.restaurant_name : null,\n  owner_name:  signup ? signup.owner_name : null,\n  owner_email: signup ? signup.owner_email : null,\n  phone: signup ? signup.phone : null,\n  plan:  signup ? signup.plan : null,\n  amount: signup ? signup.amount : null,\n  password,\n}}];"
      }
    },
    {
      "id": "m7",
      "name": "Needs Provisioning",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.provision }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "m8",
      "name": "Create Restaurant Account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_PUBLIC_URL }}/webhook/restaurant-onboard",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"restaurantName\": \"{{ $json.restaurant_name }}\",\n  \"ownerName\":      \"{{ $json.owner_name }}\",\n  \"ownerEmail\":     \"{{ $json.owner_email }}\",\n  \"ownerPassword\":  \"{{ $json.password }}\",\n  \"phone\":          {{ $json.phone ? '\"' + $json.phone + '\"' : 'null' }},\n  \"plan\":           \"{{ $json.plan }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "m9",
      "name": "Mark Provisioned",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "https://nlwrkumlrudfgsdnhfhw.supabase.co/rest/v1/rpc/mark_signup_provisioned",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_signup_id\":     \"{{ $('Decide Provisioning').item.json.signup_id }}\",\n  \"p_restaurant_id\": \"{{ $json.restaurantId || $json.restaurant_id }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "m11",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2200,
        380
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}"
      }
    },
    {
      "id": "m10",
      "name": "Apply Subscription State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "https://nlwrkumlrudfgsdnhfhw.supabase.co/rest/v1/rpc/apply_subscription_state",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_preapproval_id\":    \"{{ $('Decide Provisioning').item.json.preapproval_id }}\",\n  \"p_status\":            \"{{ $('Decide Provisioning').item.json.mp_status }}\",\n  \"p_next_payment_date\": {{ $('Decide Provisioning').item.json.next_payment_date ? '\"' + $('Decide Provisioning').item.json.next_payment_date + '\"' : 'null' }}\n}",
        "options": {}
      }
    }
  ],
