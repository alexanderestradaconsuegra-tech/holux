        "jsCode": "const data = $('Validate & Transform').item.json;\nconst orderId = data.orderId;\n\nconst orderItems = data.items.map(item => ({\n  order_id: orderId,\n  menu_item_id: item.menu_item_id,\n  dish_name: item.dish_name,\n  qty: item.qty ?? 1,\n  unit_price: item.unit_price,\n  status: 'pending'\n}));\n\nreturn [{ json: { orderItems, orderId, restaurant_id: data.restaurant_id, qr_token: data.qr_token } }];"
