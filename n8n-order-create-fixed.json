    {
      "parameters": {
        "jsCode": "// ── Validate & Transform ─────────────────────────────────────\nconst body = $input.first().json.body ?? $input.first().json;\n\nconst restaurant_id = body.restaurant_id || 'holu';\n\nif (!body.qr_token) throw new Error('Missing required field: qr_token');\n\nif (!Array.isArray(body.items) || body.items.length === 0) {\n  throw new Error('items must be a non-empty array');\n}\n\nconst items = body.items.map(item => {\n  const menu_item_id = item.menu_item_id || item.id;\n  const dish_name    = item.dish_name    || item.name;\n  const unit_price   = item.unit_price   || item.price;\n  const qty          = (typeof item.qty === 'number' && item.qty >= 1) ? item.qty : 1;\n  if (!menu_item_id || !dish_name || !unit_price) {\n    throw new Error('Item inválido: se requiere id, nombre y precio');\n  }\n  return { menu_item_id, dish_name, unit_price, qty };\n});\n\nconst digits   = String(Math.floor(Math.random() * 10000)).padStart(4, '0');\nconst orderId  = `ORD-${digits}`;\nconst sessionId = body.session_id || `SES-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;\nconst total    = items.reduce((sum, item) => sum + (item.unit_price * item.qty), 0);\n\nreturn [{\n  json: {\n    orderId,\n    sessionId,\n    restaurant_id,\n    qr_token:    body.qr_token,\n    table_id:    body.table_id    ?? null,\n    waiter_id:   body.waiter_id   ?? null,\n    notes:       body.notes       ?? null,\n    channel:     body.channel     ?? 'QR Mesa',\n    priority:    body.priority    ?? 'Normal',\n    eta_minutes: body.eta_minutes ?? 18,\n    total,\n    items\n  }\n}];"
      },
